# Answers *.finnip with the server's Tailscale IP. Tailscale split DNS sends only "finnip"
# queries here (admin console: DNS > nameserver {$FINNIP_IP}, restricted to finnip).
finnip {
	bind {$FINNIP_IP}
	template IN A {
		answer "{{ .Name }} 60 IN A {$FINNIP_IP}"
	}
	template IN AAAA {
		rcode NOERROR
	}
	errors
}
